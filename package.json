{
  "name": "tennis-alert",
  "version": "1.0.0",
  "description": "고양특례시테니스협회 테니스장 취소(빈자리) 알림 웹앱",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node --use-system-ca server.js",
