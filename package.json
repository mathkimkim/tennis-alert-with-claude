    "gen-vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "serverless-http": "^3.2.0",
    "web-push": "^3.6.7"
  }
}
